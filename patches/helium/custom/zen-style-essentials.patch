+// VerticalEssentialsContainer displays a compact favicon grid of pinned "Essential"
+// shortcuts at the top of the vertical tab strip.
+class VerticalEssentialsContainer : public views::View,
+                                    public TabStripModelObserver {
+  METADATA_HEADER(VerticalEssentialsContainer, views::View)
+
  public:
+  VerticalEssentialsContainer(
+      tabs::VerticalTabStripStateController* state_controller,
+      BrowserWindowInterface* browser);
+  VerticalEssentialsContainer(const VerticalEssentialsContainer&) = delete;
+  VerticalEssentialsContainer& operator=(const VerticalEssentialsContainer&) = delete;
+  ~VerticalEssentialsContainer() override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+
+  void SetCollapsed(bool collapsed);
+  bool IsCollapsed() const { return collapsed_; }
+
+  void AddEssential(const GURL& url, const std::u16string& title);
+  void RemoveEssential(const GURL& url);
+  bool HasEssential(const GURL& url) const;
+  void ReorderEssential(size_t from_index, size_t to_index);
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  void Layout(PassKey) override;
+
+ private:
+  void RefreshButtons();
+  void LoadPersistedEssentials();
+  void SavePersistedEssentials();
+  void OnEssentialClicked(const GURL& url);
+
+  raw_ptr<tabs::VerticalTabStripStateController> state_controller_ = nullptr;
+  raw_ptr<BrowserWindowInterface> browser_ = nullptr;
+  bool collapsed_ = false;
+
+  std::vector<std::pair<GURL, std::u16string>> essentials_;
+  std::vector<raw_ptr<EssentialFaviconButton>> buttons_;
+};
+
