+namespace {
+
+constexpr int kGridColumns = 2;
+constexpr int kCellSize = 32;
+constexpr int kGridSpacing = 4;
+constexpr int kCornerRadius = 6;
+
+}  // namespace
+
+class EssentialFaviconButton : public views::ImageButton {
+  METADATA_HEADER(EssentialFaviconButton, views::ImageButton)
+
+ public:
+  EssentialFaviconButton(const GURL& url,
+                         const std::u16string& title,
+                         base::RepeatingClosure on_clicked)
+      : views::ImageButton(std::move(on_clicked)), url_(url) {
+    SetTooltipText(title);
+    SetAccessibleName(title);
+    views::HighlightPathGenerator::Install(
+        this,
+        std::make_unique<views::RoundRectHighlightPathGenerator>(
+            gfx::Insets(), kCornerRadius));
+    views::InkDrop::Get(this)->SetMode(views::InkDropHost::InkDropMode::ON);
+  }
+  ~EssentialFaviconButton() override = default;
+
+  const GURL& url() const { return url_; }
+
+  void OnPaintBackground(gfx::Canvas* canvas) override {
+    views::ImageButton::OnPaintBackground(canvas);
+    if (GetHovered() || HasFocus()) {
+      cc::PaintFlags flags;
+      flags.setAntiAlias(true);
+      flags.setStyle(cc::PaintFlags::kFill_Style);
+      flags.setColor(GetColorProvider()->GetColor(kColorToolbarButtonBackgroundHighlighted));
+      canvas->DrawRoundRect(gfx::RectF(GetLocalBounds()), kCornerRadius, flags);
+    }
+  }
+
+ private:
+  GURL url_;
+};
+
+BEGIN_METADATA(EssentialFaviconButton)
+END_METADATA
+
+VerticalEssentialsContainer::VerticalEssentialsContainer(
+    tabs::VerticalTabStripStateController* state_controller,
+    BrowserWindowInterface* browser)
+    : state_controller_(state_controller), browser_(browser) {
+  LoadPersistedEssentials();
+  RefreshButtons();
+
+  if (browser_ && browser_->GetTabStripModel()) {
+    browser_->GetTabStripModel()->AddObserver(this);
+  }
+}
+
+VerticalEssentialsContainer::~VerticalEssentialsContainer() {
+  if (browser_ && browser_->GetTabStripModel()) {
+    browser_->GetTabStripModel()->RemoveObserver(this);
+  }
+}
+
+void VerticalEssentialsContainer::SetCollapsed(bool collapsed) {
+  if (collapsed_ == collapsed) {
+    return;
+  }
+  collapsed_ = collapsed;
+  InvalidateLayout();
+}
+
+void VerticalEssentialsContainer::AddEssential(const GURL& url,
+                                               const std::u16string& title) {
+  if (HasEssential(url)) {
+    return;
+  }
+  essentials_.emplace_back(url, title);
+  SavePersistedEssentials();
+  RefreshButtons();
+}
+
+void VerticalEssentialsContainer::RemoveEssential(const GURL& url) {
+  std::erase_if(essentials_, [&url](const auto& item) { return item.first == url; });
+  SavePersistedEssentials();
+  RefreshButtons();
+}
+
+bool VerticalEssentialsContainer::HasEssential(const GURL& url) const {
+  for (const auto& item : essentials_) {
+    if (item.first == url) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void VerticalEssentialsContainer::ReorderEssential(size_t from_index,
+                                                   size_t to_index) {
+  if (from_index >= essentials_.size() || to_index >= essentials_.size()) {
+    return;
+  }
+  auto item = std::move(essentials_[from_index]);
+  essentials_.erase(essentials_.begin() + from_index);
+  essentials_.insert(essentials_.begin() + to_index, std::move(item));
+  SavePersistedEssentials();
+  RefreshButtons();
+}
+
 void VerticalEssentialsContainer::OnTabStripModelChanged(
     TabStripModel* tab_strip_model,
     const TabStripModelChange& change,
     const TabStripSelectionChange& selection) {
   // Keep button states in sync with open tabs
 }
 
 void VerticalEssentialsContainer::LoadPersistedEssentials() {
   essentials_.clear();
   if (!browser_ || !browser_->GetProfile()) {
     return;
   }
   PrefService* prefs = browser_->GetProfile()->GetPrefs();
   if (!prefs) {
     return;
   }
   const base::Value::List& list = prefs->GetList(prefs::kHeliumEssentialsList);
   for (const auto& entry : list) {
     if (entry.is_dict()) {
       const std::string* url_str = entry.GetDict().FindString("url");
       const std::string* title_str = entry.GetDict().FindString("title");
       if (url_str) {
         essentials_.emplace_back(
             GURL(*url_str),
             title_str ? base::UTF8ToUTF16(*title_str) : std::u16string());
       }
     }
   }
 }
 
 void VerticalEssentialsContainer::SavePersistedEssentials() {
   if (!browser_ || !browser_->GetProfile()) {
     return;
   }
   PrefService* prefs = browser_->GetProfile()->GetPrefs();
   if (!prefs) {
     return;
   }
   ScopedListPrefUpdate update(prefs, prefs::kHeliumEssentialsList);
   base::Value::List& list = update.Get();
   list.clear();
   for (const auto& [url, title] : essentials_) {
     base::Value::Dict dict;
     dict.Set("url", url.spec());
     dict.Set("title", base::UTF16ToUTF8(title));
     list.Append(std::move(dict));
   }
 }
 
 void VerticalEssentialsContainer::OnEssentialClicked(const GURL& url) {
   if (!browser_) {
     return;
   }
   TabStripModel* model = browser_->GetTabStripModel();
   if (model) {
     for (int i = 0; i < model->count(); ++i) {
       content::WebContents* contents = model->GetWebContentsAt(i);
       if (contents && contents->GetVisibleURL() == url) {
         model->ActivateTabAt(i);
         return;
       }
     }
   }
   NavigateParams params(browser_->GetBrowser(), url, ui::PAGE_TRANSITION_AUTO_BOOKMARK);
   params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
   Navigate(&params);
 }
 
 void VerticalEssentialsContainer::RefreshButtons() {
   RemoveAllChildViews();
   buttons_.clear();
   for (const auto& [url, title] : essentials_) {
     auto button = std::make_unique<EssentialFaviconButton>(
         url, title,
         base::BindRepeating(&VerticalEssentialsContainer::OnEssentialClicked,
                             base::Unretained(this), url));
     buttons_.push_back(AddChildView(std::move(button)));
   }
   InvalidateLayout();
 }
 
 gfx::Size VerticalEssentialsContainer::CalculatePreferredSize(
     const views::SizeBounds& available_size) const {
   if (essentials_.empty()) {
     return gfx::Size();
   }
   const int columns = collapsed_ ? 1 : kGridColumns;
   const int rows = (essentials_.size() + columns - 1) / columns;
   const int width = columns * kCellSize + (columns - 1) * kGridSpacing;
   const int height = rows * kCellSize + (rows - 1) * kGridSpacing;
   return gfx::Size(width, height);
 }
 
 void VerticalEssentialsContainer::Layout(PassKey) {
   if (essentials_.empty()) {
     return;
   }
   const int columns = collapsed_ ? 1 : kGridColumns;
   for (size_t i = 0; i < buttons_.size(); ++i) {
     const int col = i % columns;
     const int row = i / columns;
     const int x = col * (kCellSize + kGridSpacing);
     const int y = row * (kCellSize + kGridSpacing);
     buttons_[i]->SetBounds(x, y, kCellSize, kCellSize);
   }
 }
 
 BEGIN_METADATA(VerticalEssentialsContainer)
